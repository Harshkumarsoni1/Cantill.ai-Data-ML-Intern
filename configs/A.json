{
  "currency": "ZAR",
  "taxonomy": "taxonomy_A.csv",
  "levels": [
    "category_l1",
    "category_l2",
    "category_l3"
  ],
  "labels": "labels_A.csv",
  "label_id": "record_id",
  "sources": [
    {
      "file": "erp_goods_receipts.csv",
      "prefix": "ERP:",
      "role": "primary",
      "id": "line_id",
      "description": [
        "material_short_text",
        "service_short_text"
      ],
      "context": [
        "material_type"
      ],
      "item": "material_number",
      "supplier": "supplier_name",
      "amount": "value_zar",
      "date": "posting_date",
      "po": "po_number",
      "quantity": "quantity"
    },
    {
      "file": "invoice_tool_export.csv",
      "prefix": "TOOL:",
      "role": "secondary",
      "id": "tool_record_id",
      "description": [
        "line_text"
      ],
      "supplier": "supplier_name_as_captured",
      "amount": "gross_amount",
      "tax_default": 0.15,
      "tax": "vat_rate",
      "date": "invoice_date",
      "po": "po_reference",
      "quantity": "quantity",
      "invoice": "invoice_number",
      "status": "status"
    }
  ]
}
